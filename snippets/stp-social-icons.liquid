<style>
  .stp-icon-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px 36px;
    border-top: 1px solid rgba(255,255,255,0.08);
    justify-content: flex-end;
  }
  .stp-icon-sep {
    width: 1px;
    height: 14px;
    background: rgba(255,255,255,0.15);
    margin: 0 8px;
  }
  .stp-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #A8CEDE;
    opacity: 0.5;
    transition: opacity 0.15s;
    text-decoration: none;
  }
  .stp-social-icon:hover { opacity: 1; }
</style>
