{% comment %}
  STP Hero Banner — sections/stp-hero-banner.liquid
  Includes: band photo, CTA buttons, nav icon bar with social/streaming links
{% endcomment %}

<section class="stp-hero-wrapper">
  {% if section.settings.band_photo != blank %}
    <div class="stp-hero-photo">
      <img
        src="{{ section.settings.band_photo | image_url: width: 1600 }}"
        alt="{{ section.settings.band_photo.alt | default: 'Sweet Tea Pedigree' | escape }}"
        loading="eager" width="1600" height="600">
    </div>
  {% else %}
    <div class="stp-hero-photo stp-hero-photo--empty">
      <p>Upload your band photo in the theme editor</p>
      <span>Recommended: 1600 × 600px</span>
    </div>
  {% endif %}

  {% if section.settings.show_overlay %}
    <div class="stp-hero-overlay">
      {% if section.settings.eyebrow != blank %}
        <p class="stp-hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.headline != blank %}
        <h1 class="stp-hero-headline">{{ section.settings.headline }}</h1>
      {% endif %}
      <div class="stp-hero-buttons">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_link }}" class="stp-btn stp-btn--solid">{{ section.settings.btn1_label }}</a>
        {% endif %}
        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_link }}" class="stp-btn stp-btn--outline">{{ section.settings.btn2_label }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  .stp-hero-wrapper { position: relative; width: 100%; border-bottom: 3px solid #EDD835; overflow: hidden; }
  .stp-hero-photo { width: 100%; height: 420px; overflow: hidden; }
  .stp-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
  .stp-hero-photo--empty { background: #2D7A5F; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border: 2px dashed #4BAE8A; }
  .stp-hero-photo--empty p { font-family: 'Josefin Sans', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 3px; text-transform: uppercase; color: #A8CEDE; }
  .stp-hero-photo--empty span { font-family: 'Josefin Sans', sans-serif; font-size: 11px; color: #4BAE8A; }
  .stp-hero-overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(26,92,69,0.85) 0%, transparent 100%); padding: 40px 48px 32px; }
  .stp-hero-eyebrow { font-family: 'Josefin Sans', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: #EDD835; margin-bottom: 8px; }
  .stp-hero-headline { font-family: 'Alfa Slab One', serif; font-size: 42px; color: #FFFFFF; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 20px; line-height: 1.1; }
  .stp-hero-buttons { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 749px) {
    .stp-hero-photo { height: 280px; }
    .stp-hero-headline { font-size: 28px; }
    .stp-hero-overlay { padding: 24px 20px 20px; }
  }
</style>

{% schema %}
{
  "name": "STP Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "band_photo", "label": "Band header photo", "info": "Recommended: 1600 × 600px" },
    { "type": "checkbox", "id": "show_overlay", "label": "Show text overlay on photo", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "New Single Out Now" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Sweet Tea Pedigree" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 text", "default": "Stream Now" },
    { "type": "url",  "id": "btn1_link",  "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 text", "default": "Buy Vinyl" },
    { "type": "url",  "id": "btn2_link",  "label": "Button 2 link" }
  ],
  "presets": [{ "name": "STP Hero Banner" }]
}
{% endschema %}
