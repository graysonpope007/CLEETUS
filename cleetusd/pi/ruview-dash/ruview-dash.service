[Unit]
# The studio WiFi sensing panel. A --user unit on purpose: /etc/systemd/system
# needs root and gpope04 has no NOPASSWD line, so a system unit could never be
# installed or repaired unattended. Linger is on for this user, so this starts
# at boot without anyone logging in.
Description=RuView sensing dashboard (serves the panel and the tailnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RUVIEW_DASH_PORT=8790
Environment=RUVIEW_DASH_HOST=0.0.0.0
Environment=RUVIEW_UPSTREAM=http://192.168.2.1:8767,https://me.cleetusai.com
Environment=RUVIEW_TOKEN_FILE=/opt/protocol-pi/secrets/ruview.token
# The ceiling that actually holds. After six days this process had 2.9 GB of
# the Pi's 4 GB and the panel froze (16 Sep 2026). MemoryMax below is the
# right systemd answer, but on this Pi the memory controller is not delegated
# to user slices (user@1000.service has only "cpu pids" in subtree_control),
# so a --user unit's MemoryMax is written and never enforced: MemoryCurrent
# reads "[not set]". Enabling delegation needs root. Until then V8 enforces
# its own heap limit, throws, the process dies, and Restart=always brings it
# back in 5 s with an empty heap.
ExecStart=/usr/bin/node --max-old-space-size=384 %h/ruview-dash/server.mjs
MemoryMax=500M
MemorySwapMax=0
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
