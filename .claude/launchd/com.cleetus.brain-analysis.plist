  <key>StandardOutPath</key>
  <string>/tmp/cleetus-brain-analysis.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cleetus-brain-analysis.err</string>

  <key>EnvironmentVariables</key>
