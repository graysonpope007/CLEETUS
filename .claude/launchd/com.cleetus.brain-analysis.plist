    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLEETUS_VAULT</key>
    <string>/Users/grayson/Library/Mobile Documents/iCloud~md~obsidian/Documents/Cleetus</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
